{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/conteudo/Badge/**",
              "components/conteudo/Card/**",
              "components/conteudo/CaseCard/**",
              "components/conteudo/IconBubble/**",
              "components/conteudo/ImpactNumber/**",
              "components/conteudo/Separator/**",
              "components/controles/Button/**",
              "components/controles/Toggle/**",
              "components/controles/ToggleGroup/**",
              "components/navegacao/FilterChips/**",
              "components/navegacao/GlassNav/**",
              "components/navegacao/NavigationMenu/**",
              "components/secoes/Hero/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|Figtree))/i]",
        "message": "Font not provided by the design system. Available: Outfit, Figtree."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|variant|asChild|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: ref, className, id, style, children, variant, asChild."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:link|default|outline|secondary|ghost|destructive)$/]",
        "message": "<Badge> variant must be one of 'link' | 'default' | 'outline' | 'secondary' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|variant|size|asChild|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: ref, className, id, style, children, variant, size, asChild."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:link|default|outline|secondary|ghost|destructive|highlight)$/]",
        "message": "<Button> variant must be one of 'link' | 'default' | 'outline' | 'secondary' | 'ghost' | 'destructive' | 'highlight'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|xs|sm|lg|icon|icon-xs|icon-sm|icon-lg|xl)$/]",
        "message": "<Button> size must be one of 'default' | 'xs' | 'sm' | 'lg' | 'icon' | 'icon-xs' | 'icon-sm' | 'icon-lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|size|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: ref, className, id, style, children, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm)$/]",
        "message": "<Card> size must be one of 'default' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|context|impact|href|className|key|ref|className|style|children)$/]",
        "message": "<CaseCard> doesn't accept that prop. Declared props: icon, title, context, impact, href, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChips'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onValueChange|key|ref|className|style|children)$/]",
        "message": "<FilterChips> doesn't accept that prop. Declared props: options, value, onValueChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|dir|orientation|delayDuration|skipDelayDuration|style|className|id|children|asChild|ref|viewport|key|ref|className|style|children)$/]",
        "message": "<GlassNav> doesn't accept that prop. Declared props: value, defaultValue, dir, orientation, delayDuration, skipDelayDuration, style, className, id, children, asChild, ref, viewport."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassNav'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:ltr|rtl)$/]",
        "message": "<GlassNav> dir must be one of 'ltr' | 'rtl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassNav'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<GlassNav> orientation must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|className|ref|id|children|title|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: style, className, ref, id, children, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|className|key|ref|className|style|children)$/]",
        "message": "<IconBubble> doesn't accept that prop. Declared props: icon, tone, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconBubble'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|muted)$/]",
        "message": "<IconBubble> tone must be one of 'brand' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImpactNumber'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|label|key|ref|className|style|children)$/]",
        "message": "<ImpactNumber> doesn't accept that prop. Declared props: value, unit, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavigationMenu'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|dir|orientation|delayDuration|skipDelayDuration|style|className|id|children|asChild|ref|viewport|key|ref|className|style|children)$/]",
        "message": "<NavigationMenu> doesn't accept that prop. Declared props: value, defaultValue, dir, orientation, delayDuration, skipDelayDuration, style, className, id, children, asChild, ref, viewport."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavigationMenu'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:ltr|rtl)$/]",
        "message": "<NavigationMenu> dir must be one of 'ltr' | 'rtl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavigationMenu'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<NavigationMenu> orientation must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|decorative|style|className|id|children|asChild|ref|key|ref|className|style|children)$/]",
        "message": "<Separator> doesn't accept that prop. Declared props: orientation, decorative, style, className, id, children, asChild, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<Separator> orientation must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:pressed|defaultPressed|style|className|id|children|asChild|ref|variant|size|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: pressed, defaultPressed, style, className, id, children, asChild, ref, variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|outline|chip)$/]",
        "message": "<Toggle> variant must be one of 'default' | 'outline' | 'chip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm|lg|pill)$/]",
        "message": "<Toggle> size must be one of 'default' | 'sm' | 'lg' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|value|defaultValue|disabled|rovingFocus|loop|orientation|dir|style|className|id|children|asChild|ref|variant|size|spacing|key|ref|className|style|children)$/]",
        "message": "<ToggleGroup> doesn't accept that prop. Declared props: type, value, defaultValue, disabled, rovingFocus, loop, orientation, dir, style, className, id, children, asChild, ref, variant, size, spacing."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleGroup'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:single|multiple)$/]",
        "message": "<ToggleGroup> type must be one of 'single' | 'multiple'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleGroup'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<ToggleGroup> orientation must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleGroup'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:ltr|rtl)$/]",
        "message": "<ToggleGroup> dir must be one of 'ltr' | 'rtl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleGroup'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|outline|chip)$/]",
        "message": "<ToggleGroup> variant must be one of 'default' | 'outline' | 'chip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleGroup'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm|lg|pill)$/]",
        "message": "<ToggleGroup> size must be one of 'default' | 'sm' | 'lg' | 'pill'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Badge": {
        "replaces": []
      },
      "Button": {
        "replaces": [
          "button"
        ]
      },
